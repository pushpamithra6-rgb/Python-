import math
n = int(input('Enter a number: '))
if n <= 1:
    print(f'{n} is Not a Prime Number')
else:
    is_prime = True
    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            is_prime = False
            break
    if is_prime:
        print(f'{n} is a Prime Number')
    else:
        print(f'{n} is Not a Prime Number')
